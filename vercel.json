{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/snapshot",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/snapshot-retry",
      "schedule": "20 1 * * *"
    }
  ]
}
